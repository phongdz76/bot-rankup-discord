# Discord Bot Configuration
# false: only run the local dashboard while the production bot runs on Render.
BOT_ENABLED=true
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
# Tùy chọn: chỉ dùng để nhập cấu hình server v1, KHÔNG giới hạn bot.
GUILD_ID=
LEVEL_UP_CHANNEL_ID=

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hutao_rankup?retryWrites=true&w=majority

# Web server (HTTP local; HTTPS trên hosting)
PORT=3000
NODE_ENV=development
DASHBOARD_URL=http://localhost:3000

# Discord OAuth2 (bỏ trống nếu chỉ chạy bot + trang hướng dẫn)
DISCORD_CLIENT_SECRET=
OAUTH2_CALLBACK_URL=http://localhost:3000/auth/discord/callback
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Discord Role IDs (4 Bậc Thăng Tiến)
ROLE_LVL0_ID=
ROLE_LVL5_ID=
ROLE_LVL15_ID=
ROLE_LVL30_ID=
