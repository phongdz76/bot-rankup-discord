<%- include('partials/header') %>
<main id="main" class="container page-content">
  <p class="eyebrow">Máy chủ của tôi</p><h1>Chọn máy chủ của bạn</h1>
  <p class="lead">Xin chào <%= user.username %>! Đây là các máy chủ bạn có quyền quản lý.</p>
  <div class="server-grid">
    <% for (const guild of guilds) { %>
      <article class="panel server-card">
        <div class="server-top"><% if (guild.icon) { %><img class="server-icon" src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128" alt="" width="56" height="56"><% } else { %><span class="server-icon server-placeholder"><%= guild.name.slice(0, 2) %></span><% } %><span class="pill <%= guild.botPresent ? 'online' : '' %>"><%= guild.botPresent ? 'Đã có Hutao-Chan' : 'Chưa có bot' %></span></div>
        <h2><%= guild.name %></h2><p><%= guild.memberCount ? guild.memberCount.toLocaleString('vi-VN') + ' thành viên' : 'Sẵn sàng kết nối cộng đồng' %></p>
        <% if (guild.botPresent) { %><a class="button secondary full" href="/servers/<%= guild.id %>">Quản lý máy chủ →</a><% } else { %><a class="button secondary full" href="<%= inviteUrl %>&guild_id=<%= guild.id %>&disable_guild_select=true">Mời bot vào máy chủ ↗</a><% } %>
      </article>
    <% } %>
  </div>
  <% if (!guilds.length) { %><div class="panel empty-state"><h2>Chưa tìm thấy máy chủ để quản lý</h2><p>Bạn cần quyền Quản lý máy chủ hoặc Quản trị viên. Sau khi được cấp quyền, hãy tải lại trang.</p></div><% } %>
</main>
<%- include('partials/footer') %>
